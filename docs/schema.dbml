// ============================================================
// OxyPC Inventory — Complete DBML Schema
// Generated: 2026-04-29 | Tables: 57 | Source: models/
// Import at: https://dbdiagram.io
// ============================================================

// ── users ────────────────────────────────────────────────────
Table users {
  id uuid [pk, not null]
  username varchar(50) [not null, unique, note: 'indexed']
  full_name varchar(100) [not null]
  password_hash varchar(200) [not null]
  role varchar(50) [not null, default: 'sales']
  status bool [default: true]
  created_at datetime [default: `now()`]
  created_by varchar(50)
  last_login datetime
  tenant varchar(50) [default: 'oxypc_internal', note: 'indexed']
}

// ── login_logs ───────────────────────────────────────────────
Table login_logs {
  id uuid [pk, not null]
  user_id uuid [not null]
  action varchar(50) [not null]
  ip_address varchar(50)
  timestamp datetime [default: `now()`]
  notes varchar(200)
}

// ── user_permissions ─────────────────────────────────────────
Table user_permissions {
  id uuid [pk, not null]
  user_id uuid [not null]
  permission varchar(100) [not null]
  granted bool [default: true]
  granted_by varchar(50)
  granted_at datetime [default: `now()`]
}

// ── lots ─────────────────────────────────────────────────────
Table lots {
  id uuid [pk, not null]
  lot_number varchar(20) [not null, unique, note: 'indexed']
  supplier_name varchar(200) [not null]
  grn_system_number varchar(50)
  grn_number_new int
  grn_date datetime
  invoice_date datetime
  invoice_no varchar(100)
  invoice_value decimal(14,2)
  taxable_amount decimal(14,2)
  sgst decimal(12,2)
  cgst decimal(12,2)
  igst decimal(12,2)
  vehicle_number varchar(30)
  e_way_bill varchar(50)
  po_number varchar(100)
  vendor_name varchar(200)
  buying_price decimal(12,2) [not null]
  qty int [not null]
  purchase_date datetime [not null]
  notes text
  created_by varchar(50)
  created_at datetime [default: `now()`]
}

// ── lot_line_items ───────────────────────────────────────────
Table lot_line_items {
  id uuid [pk, not null]
  lot_id uuid [not null, note: 'indexed']
  sub_category varchar(50) [not null]
  brand varchar(50)
  model varchar(100)
  cpu varchar(100)
  generation varchar(50)
  ram_gb int
  has_ram bool [default: true]
  storage_gb int
  storage_type varchar(20)
  has_storage bool [default: true]
  screen_size varchar(20)
  grade varchar(10)
  unit_price decimal(12,2) [not null]
  qty int [not null, default: 1]
  notes text
  created_at datetime [default: `now()`]
}

// ── devices ──────────────────────────────────────────────────
Table devices {
  id uuid [pk, not null]
  barcode varchar(100) [not null, unique, note: 'indexed']
  lot_id uuid [not null]
  brand varchar(50) [note: 'indexed']
  model varchar(100)
  device_type varchar(30)
  serial_no varchar(100)
  sub_category varchar(20) [note: 'indexed']
  cpu varchar(100)
  cpu_make varchar(100) [note: 'Intel / AMD / Apple — derived from IQC agent or manual entry']
  generation varchar(50)
  ram_gb int
  storage_gb int
  storage_type varchar(20)
  ram_type varchar(20)
  ram_speed varchar(20)
  ram_make varchar(50)
  hdd_capacity_gb int
  hdd_type varchar(20)
  hdd_speed varchar(20)
  ram_summary varchar(255) [note: 'per-DIMM auto-detected summary from IQC agent, e.g. "8GB DDR4 3200MHz Samsung x2"']
  hdd_summary varchar(255) [note: 'per-disk auto-detected summary from IQC agent, e.g. "512GB NVMe Samsung"']
  battery_health_pct int
  screen_size varchar(20)
  color varchar(30)
  bios_password bool [default: false]
  grade varchar(10)
  final_qc_status varchar(10) [note: 'pass / fail — set on Final QC decision, indexed']
  l1l2_status varchar(30) [default: 'New', note: 'New | Repair Started | Requested to L3/L4 — drives L1/L2 Repair page actions']
  l34_status varchar(30) [note: 'Repair Started | Completed | Normal Scrap | Replacement Scrap — set by L3/L4 page, read by L1/L2 L3/L4-Status col']
  current_stage varchar(30) [not null, default: 'iqc', note: 'indexed']
  floor varchar(50)
  warehouse varchar(100)
  grn_number varchar(50)
  device_price decimal(12,2)
  lot_line_item_id uuid
  notes text
  partner_listed bool [not null, default: false, note: 'backing a live Trade Partner listing']
  created_at datetime [default: `now()`]
  updated_at datetime [default: `now()`, note: 'indexed']
}

// ── stage_movements ──────────────────────────────────────────
Table stage_movements {
  id uuid [pk, not null]
  device_id uuid [not null]
  from_stage varchar(30)
  to_stage varchar(30) [not null]
  moved_by varchar(50)
  moved_at datetime [default: `now()`]
  exited_at datetime
  notes text
}

// ── repair_jobs ──────────────────────────────────────────────
Table repair_jobs {
  id uuid [pk, not null]
  device_id uuid [not null, note: 'indexed']
  stage varchar(5) [not null, note: 'indexed']
  engineer_id uuid
  engineer_name varchar(100)
  started_at datetime [default: `now()`]
  completed_at datetime
  issue_description text
  resolution text
  status varchar(30) [default: 'open', note: 'indexed']
  team_name varchar(100)
  assigned_engineer varchar(100)
  faults text
  dust_cleaning varchar(20)
  cmos_battery_change varchar(20)
  thermal_paste varchar(20)
  final_status varchar(30)
  ram_status varchar(20)
  ram_removed_gb varchar(20)
  ram_added_gb varchar(20)
  hdd_updated varchar(5)
  hdd_removed varchar(30)
  hdd_added varchar(30)
  problem_reported text
  action_taken varchar(50)
  problem_observed text
  scrap_reason varchar(100)
  received_from varchar(50)
  customer_internal varchar(30)
}

// ── qc_checks ────────────────────────────────────────────────
Table qc_checks {
  id uuid [pk, not null]
  device_id uuid [not null, note: 'indexed']
  inspector_id uuid
  inspector_name varchar(100)
  battery_score int
  screen_score int
  keyboard_score int
  body_score int
  total_score int
  result varchar(10) [not null]
  grade varchar(5)
  attempt_number int [not null, default: 1]
  checked_at datetime [default: `now()`]
  notes text
  issues_found text
  send_to_stage varchar(20)
}

// ── sales ────────────────────────────────────────────────────
Table sales {
  id uuid [pk, not null]
  sale_number varchar(20) [not null, unique, note: 'indexed']
  device_id uuid [not null]
  sale_price decimal(12,2) [not null]
  customer_name varchar(100)
  customer_phone varchar(20)
  customer_state varchar(100)
  invoice_no varchar(50)
  payment_mode varchar(20)
  sold_by varchar(50) [note: 'indexed']
  sold_at datetime [default: `now()`]
  notes text
  sale_channel varchar(20) [note: 'procurement / telecaller / showroom — Admin Dashboard analytics']
}

// ── parts_grn ────────────────────────────────────────────────
Table parts_grn {
  id uuid [pk, not null]
  grn_number varchar(20) [not null, unique, note: 'indexed']
  po_number varchar(50)
  po_date datetime
  invoice_number varchar(50)
  invoice_date datetime
  eway_bill_number varchar(50)
  vehicle_number varchar(50)
  status varchar(20) [not null, default: 'in_plan', note: 'in_plan / in_trc — Admin Dashboard analytics']
  date_received datetime
  vendor_name varchar(150)
  invoice_value decimal(12,2)
  total_po_qty int
  total_invoice_qty int
  total_physical_qty int
  total_amount_invoice decimal(12,2)
  created_by varchar(50)
  created_at datetime [default: `now()`]
  is_trashed boolean [not null, default: false]
  trashed_at datetime
}

// ── returns ──────────────────────────────────────────────────
Table returns {
  id uuid [pk, not null]
  sale_id uuid [not null, note: 'indexed']
  device_id uuid [not null, note: 'indexed']
  return_date datetime [default: `now()`]
  reason text
  condition_on_return varchar(50)
  action_taken varchar(30)
  reentered_stage varchar(50)
  processed_by varchar(50)
  refund_amount decimal(12,2)
  notes text
}

// ── spare_parts ──────────────────────────────────────────────
Table spare_parts {
  id uuid [pk, not null]
  part_code varchar(20) [not null, unique, note: 'indexed']
  name varchar(150) [not null]
  category varchar(30) [not null]
  unit_price decimal(10,2) [not null, default: 0]
  qty_in_stock int [not null, default: 0]
  min_stock_alert int [not null, default: 5]
  supplier varchar(100)
  notes text
  created_at datetime [default: `now()`]
}

// ── spare_parts_purchases ────────────────────────────────────
Table spare_parts_purchases {
  id uuid [pk, not null]
  part_id uuid [not null]
  qty int [not null]
  unit_price decimal(10,2) [not null]
  total_price decimal(12,2) [not null]
  supplier varchar(100)
  purchase_date datetime [not null, default: `now()`]
  invoice_no varchar(50)
  purchased_by varchar(50)
}

// ── spare_parts_consumption ──────────────────────────────────
Table spare_parts_consumption {
  id uuid [pk, not null]
  device_id uuid
  lot_id uuid
  part_id uuid [not null]
  qty_used int [not null]
  unit_cost decimal(10,2) [not null]
  total_cost decimal(12,2) [not null]
  used_by varchar(50)
  used_at datetime [default: `now()`]
  stage varchar(20)
  notes text
}

// ── ram_tracking ─────────────────────────────────────────────
Table ram_tracking {
  id uuid [pk, not null]
  action varchar(20) [not null]
  device_id uuid
  destination_device_id uuid
  ram_gb int
  ram_type varchar(20)
  by_user varchar(50)
  at datetime [default: `now()`]
  notes text
}

// ── repair_attempts ──────────────────────────────────────────
Table repair_attempts {
  id uuid [pk, not null]
  device_id uuid [not null, note: 'indexed']
  repair_job_id uuid
  level int [not null]
  attempt_no int [not null, default: 1]
  cost decimal(10,2) [not null, default: 0]
  time_spent int
  outcome varchar(30)
  notes text
  created_by varchar(50)
  created_at datetime [default: `now()`]
}

// ── device_costing ───────────────────────────────────────────
Table device_costing {
  id uuid [pk, not null]
  device_id uuid [not null, unique, note: 'indexed']
  base_cost decimal(12,2) [not null, default: 0]
  parts_cost decimal(12,2) [not null, default: 0]
  labour_cost decimal(12,2) [not null, default: 0]
  total_cost decimal(12,2) [not null, default: 0]
  expected_sale_value decimal(12,2)
  updated_at datetime [default: `now()`]
}

// ── spare_parts_ledger ───────────────────────────────────────
Table spare_parts_ledger {
  id uuid [pk, not null]
  part_id uuid [not null, note: 'indexed']
  entry_type varchar(10) [not null]
  qty int [not null]
  cost_per_unit decimal(10,2) [not null, default: 0]
  total_cost decimal(12,2) [not null, default: 0]
  reference_type varchar(30)
  reference_id varchar(50)
  device_id uuid
  notes text
  created_by varchar(50)
  created_at datetime [default: `now()`]
}

// ── device_aging ─────────────────────────────────────────────
Table device_aging {
  id uuid [pk, not null]
  device_id uuid [not null, unique, note: 'indexed']
  days_in_stage int [not null, default: 0]
  total_days int [not null, default: 0]
  stage_entered_at datetime
  is_stuck bool [not null, default: false]
  is_dead_stock bool [not null, default: false]
  refreshed_at datetime [default: `now()`]
}

// ── audit_logs ───────────────────────────────────────────────
Table audit_logs {
  id uuid [pk, not null]
  user_id uuid
  username varchar(50)
  action varchar(50) [not null]
  table_name varchar(50)
  record_id varchar(50)
  old_value text
  new_value text
  ip_address varchar(45)
  notes text
  timestamp datetime [not null, note: 'indexed', default: `now()`]
}

// ── dealers ──────────────────────────────────────────────────
Table dealers {
  id uuid [pk, not null]
  dealer_code varchar(20) [not null, unique, note: 'indexed']
  business_name varchar(200) [not null]
  first_name varchar(100)
  last_name varchar(100)
  contact_person varchar(100)
  phone varchar(20)
  whatsapp_number varchar(20)
  email varchar(100)
  address text
  city varchar(100)
  state varchar(100)
  pincode varchar(10)
  gstin varchar(20)
  dealer_type varchar(30) [default: 'retail']
  credit_limit decimal(14,2) [default: 0]
  outstanding_amount decimal(14,2) [default: 0]
  total_purchases decimal(14,2) [default: 0]
  last_sale_date datetime
  last_sale_amount decimal(14,2)
  preferred_categories varchar(200)
  notes text
  status varchar(20) [default: 'active']
  assigned_to varchar(50)
  created_by varchar(50)
  source varchar(200)
  added_by varchar(50)
  created_at datetime [default: `now()`]
  updated_at datetime [default: `now()`]
  // Trade Partner portal (dealer-facing B2B web)
  portal_enabled bool [not null, default: false]
  portal_password_hash varchar(200) [note: 'bcrypt; login id = portal_phone']
  portal_phone varchar(20) [unique, note: 'normalized 10-digit login phone']
  partner_type varchar(20) [note: 'dealer | trader | repair_shop']
  price_segment varchar(30) [not null, default: 'new_dealer', note: 'new_dealer | verified | high_volume | city_captain | trader']
  sales_owner_username varchar(50) [note: 'drives My Desk + WhatsApp buttons']
  portal_last_login_at datetime
  portal_token_only bool [not null, default: false, note: 'penalty ladder step 3']
  portal_password_version int [not null, default: 1, note: 'bump to invalidate partner JWTs']
}

// ── dealer_assignments ───────────────────────────────────────
Table dealer_assignments {
  id uuid [pk, not null]
  dealer_id uuid [not null]
  assigned_to varchar(50) [not null]
  assigned_by varchar(50) [not null]
  assigned_at datetime [default: `now()`]
  is_active bool [default: true]
  notes text
}

// ── dealer_calls ─────────────────────────────────────────────
Table dealer_calls {
  id uuid [pk, not null]
  dealer_id uuid [not null]
  called_by varchar(50) [not null]
  call_date datetime [default: `now()`]
  call_type varchar(20) [default: 'outbound']
  call_mode varchar(20) [default: 'phone']
  duration_mins int
  call_outcome varchar(30)
  items_discussed text
  quote_given decimal(12,2)
  next_followup_date datetime [note: 'indexed']
  whatsapp_sent bool [default: false]
  notes text
  created_at datetime [default: `now()`]
}

// ── dealer_orders ────────────────────────────────────────────
Table dealer_orders {
  id uuid [pk, not null]
  dealer_id uuid [not null]
  order_number varchar(30) [not null, unique]
  order_date datetime [default: `now()`]
  items_description text
  total_amount decimal(14,2) [default: 0]
  paid_amount decimal(14,2) [default: 0]
  due_amount decimal(14,2) [default: 0]
  payment_due_date datetime
  payment_mode varchar(20)
  invoice_number varchar(50)
  invoice_sent_whatsapp bool [default: false]
  payment_reminder_sent bool [default: false]
  status varchar(20) [default: 'pending']
  notes text
  created_by varchar(50)
  created_at datetime [default: `now()`]
}

// ── dealer_credit_notes ──────────────────────────────────────
Table dealer_credit_notes {
  id uuid [pk, not null]
  credit_number varchar(30) [not null, unique, note: 'indexed']
  dealer_id uuid [not null, note: 'indexed']
  order_id uuid [note: 'indexed']
  credit_date datetime [default: `now()`]
  amount decimal(14,2) [not null]
  reason varchar(200)
  items_description text
  notes text
  created_by varchar(50)
  created_at datetime [default: `now()`]
  is_applied bool [not null, default: false]
  applied_at datetime
  applied_to_order_id uuid
}

// ── attendance ───────────────────────────────────────────────
Table attendance {
  id uuid [pk, not null]
  user_id uuid [not null, note: 'indexed']
  username varchar(50) [not null]
  full_name varchar(100)
  date date [not null, note: 'indexed']
  check_in datetime
  check_out datetime
  check_in_ip varchar(50)
  check_out_ip varchar(50)
  status varchar(20) [default: 'present']
  notes text
  marked_by varchar(50)
  created_at datetime [default: `now()`]
}

// ── storage_locations ────────────────────────────────────────
Table storage_locations {
  id uuid [pk, not null]
  zone varchar(30) [not null]
  unit_type varchar(20) [not null]
  unit_id varchar(50) [not null, unique]
  slot varchar(20)
  description varchar(200)
  capacity int
  is_active bool [default: true]
  created_at datetime [default: `now()`]
}

// ── device_location_logs ─────────────────────────────────────
Table device_location_logs {
  id uuid [pk, not null]
  device_id uuid [not null]
  location_id uuid
  action varchar(20) [not null]
  actor_id uuid [not null]
  actor_name varchar(100)
  notes text
  logged_at datetime [default: `now()`, note: 'indexed']
}

// ── inventory_audits ─────────────────────────────────────────
Table inventory_audits {
  id uuid [pk, not null]
  audit_number varchar(30) [not null, unique]
  zone_filter varchar(50)
  status varchar(20) [default: 'pending']
  initiated_by uuid [not null]
  initiated_by_name varchar(100)
  initiated_at datetime [default: `now()`]
  completed_at datetime
  notes text
  expected_count int [default: 0]
  found_count int [default: 0]
  missing_count int [default: 0]
  extra_count int [default: 0]
}

// ── audit_scan_items ─────────────────────────────────────────
Table audit_scan_items {
  id uuid [pk, not null]
  audit_id uuid [not null]
  device_id uuid
  barcode_scanned varchar(100) [not null]
  location_id uuid
  scan_status varchar(20) [not null]
  scanned_by uuid
  scanned_by_name varchar(100)
  scanned_at datetime [default: `now()`]
  notes text
}

// ── stage_master ─────────────────────────────────────────────
Table stage_master {
  id uuid [pk, not null]
  name varchar(50) [not null, unique]
  label varchar(100) [not null]
  sequence int [not null, default: 0]
  created_at datetime [default: `now()`]
}

// ── allowed_transitions ──────────────────────────────────────
Table allowed_transitions {
  id uuid [pk, not null]
  from_stage varchar(50) [not null]
  to_stage varchar(50) [not null]
  created_at datetime [default: `now()`]

  indexes {
    (from_stage, to_stage) [unique, name: 'uq_transition']
  }
}

// ── master_data ──────────────────────────────────────────────
Table master_data {
  id uuid [pk, not null]
  category varchar(50) [not null, note: 'indexed']
  value varchar(200) [not null]
  description varchar(500)
  display_order int [default: 0]
  is_active bool [default: true]
  created_at datetime [default: `now()`]

  indexes {
    (category, value) [unique, name: 'uq_master_category_value']
  }
}

// ── market_availability ──────────────────────────────────────
Table market_availability {
  id uuid [pk, not null]
  brand varchar(100)
  model varchar(200)
  category varchar(50)
  generation varchar(50)
  processor varchar(200)
  ram varchar(50)
  storage varchar(100)
  condition varchar(20)
  grade varchar(10)
  trade_type varchar(10) [not null, default: 'sell']
  qty int
  price_per_unit decimal(12,2)
  warranty_months int
  is_negotiable bool [default: true]
  dealer_id uuid
  dealer_name varchar(200)
  group_wa_id varchar(100)
  group_name varchar(200)
  source_message_id uuid
  source_message_text text
  notes text
  is_active bool [default: true]
  posted_date datetime [default: `now()`]
  expires_at datetime
  created_by varchar(50)
  created_at datetime [default: `now()`]
  updated_at datetime [default: `now()`]
}

// ── telecalling_sessions ─────────────────────────────────────
Table telecalling_sessions {
  id uuid [pk, not null]
  agent_username varchar(50) [not null]
  session_date datetime [default: `now()`]
  total_calls int [default: 0]
  connected_calls int [default: 0]
  interested_leads int [default: 0]
  orders_placed int [default: 0]
  target_calls int [default: 50]
