}

// ── whatsapp_sessions ────────────────────────────────────────
Table whatsapp_sessions {
  id uuid [pk, not null]
  username varchar(50) [not null, unique]
  phone_number varchar(20)
  status varchar(20) [default: 'disconnected']
  session_data text
  connected_at datetime
  last_seen datetime
  created_at datetime [default: `now()`]
}

// ── whatsapp_messages ────────────────────────────────────────
Table whatsapp_messages {
  id uuid [pk, not null]
  sent_by varchar(50) [not null]
  recipient_phone varchar(50) [not null]
  recipient_name varchar(100)
  message_type varchar(20) [default: 'text']
  message_text text
  dealer_id uuid
  reference_type varchar(20)
  reference_id varchar(100)
  status varchar(20) [default: 'pending']
  sent_at datetime
  error_msg text
  direction varchar(10) [default: 'outgoing']
  sender_name varchar(200)
  sender_phone varchar(30)
  created_at datetime [default: `now()`]
}

// ── whatsapp_groups ──────────────────────────────────────────
Table whatsapp_groups {
  id uuid [pk, not null]
  group_wa_id varchar(100) [not null, unique]
  group_name varchar(200) [not null]
  participant_count int [default: 0]
  tags varchar(200)
  group_category varchar(20) [default: 'other']
  linked_dealer_id uuid
  synced_by varchar(50)
  last_synced datetime [default: `now()`]
  created_at datetime [default: `now()`]
}

// ── whatsapp_broadcasts ──────────────────────────────────────
Table whatsapp_broadcasts {
  id uuid [pk, not null]
  broadcast_name varchar(200)
  message_type varchar(20) [default: 'text']
  message_text text [not null]
  sent_by varchar(50) [not null]
  total_recipients int [default: 0]
  sent_count int [default: 0]
  failed_count int [default: 0]
  status varchar(20) [default: 'done']
  created_at datetime [default: `now()`]
}

// ── app_settings ─────────────────────────────────────────────
Table app_settings {
  key varchar(50) [pk, not null]
  value text
  description varchar(200)
  updated_by varchar(50)
  updated_at datetime [default: `now()`]
}

// ── companies (Company Setting page — multiple company profiles) ──
Table companies {
  id uuid [pk, not null]
  company_name varchar(200) [not null]
  company_address varchar(500)
  company_gstin varchar(20)
  company_state varchar(100)
  company_state_code varchar(5)
  company_phone varchar(50)
  company_email varchar(100)
  is_active boolean [not null, default: true]
  created_by varchar(50)
  created_at datetime
  updated_at datetime
}

// ── iqc_inspections ──────────────────────────────────────────
Table iqc_inspections {
  id uuid [pk, not null]
  device_id uuid [not null, unique]
  inspector_name varchar(100)
  inspected_at datetime [default: `now()`]
  power_on varchar(5)
  bios_password varchar(5)
  all_ok varchar(5)
  status varchar(50)
  screen_dot varchar(10)
  screen_line varchar(10)
  screen_functional varchar(10)
  screen_discoloration varchar(10)
  screen_patch varchar(10)
  screen_broken varchar(10)
  screen_flickering varchar(10)
  screen_scratch varchar(20)
  screen_loose varchar(10)
  screen_missing varchar(10)
  screen_hinge_broken varchar(10)
  screen_colour_spread varchar(10)
  screen_keyboard_mark varchar(10)
  screen_hard_press varchar(10)
  panel_a_scratch varchar(20)
  panel_a_broken varchar(20)
  panel_a_missing varchar(10)
  panel_a_dent varchar(20)
  panel_a_colour_fade varchar(10)
  panel_b_scratch varchar(20)
  panel_b_colour_fade varchar(10)
  panel_b_rubber_cut varchar(10)
  panel_b_broken varchar(20)
  panel_b_missing varchar(10)
  panel_c_scratch varchar(20)
  panel_c_broken varchar(20)
  panel_c_missing varchar(10)
  panel_c_dent varchar(20)
  panel_c_colour_fade varchar(10)
  panel_d_dent varchar(20)
  panel_d_colour_fade varchar(10)
  panel_d_scratch varchar(20)
  panel_d_broken varchar(20)
  panel_d_missing varchar(10)
  keyboard_working varchar(10)
  keyboard_colour_fade varchar(10)
  keyboard_key_missing varchar(10)
  keyboard_hard_press varchar(10)
  speaker_status varchar(50)
  touchpad_working varchar(10)
  touchpad_click_working varchar(10)
  touchpad_scratch varchar(20)
  touchpad_colour_fade varchar(10)
  touchpad_missing varchar(10)
  port_hdmi varchar(10)
  port_usb_working varchar(10)
  port_audio_jack varchar(10)
  wifi_status varchar(20)
  webcam_status varchar(20)
  hdd_connector varchar(10)
  hdd_casing varchar(10)
  battery_present varchar(10)
  battery_cable varchar(10)
  dvd_drive varchar(10)
  r2v3_grade_category varchar(10)
  remarks text
  stress_report text
}

// ── stock_transfers ──────────────────────────────────────────
Table stock_transfers {
  id uuid [pk, not null]
  device_id uuid [not null, note: 'indexed']
  transfer_type varchar(30) [not null]
  from_warehouse varchar(100) [not null]
  to_warehouse varchar(100) [not null]
  transferred_by varchar(100)
  received_by varchar(100)
  department varchar(100)
  barcode varchar(50)
  serial_no varchar(100)
  make varchar(50)
  model varchar(100)
  cpu varchar(50)
  generation varchar(20)
  ram varchar(20)
  hdd varchar(20)
  category varchar(50)
  lot_number varchar(20)
  product_stage varchar(50)
  transfer_date datetime [not null, default: `now()`]
  notes text
  created_by varchar(50)
  created_at datetime [default: `now()`]
}

// ── crm_contacts ─────────────────────────────────────────────
Table crm_contacts {
  id uuid [pk, not null]
  from_entity varchar(100) [note: 'From Entity - issuing company entity; defaults to the creator entity (approved 2026-11-10)']
  contact_code varchar(20) [not null, unique, note: 'indexed']
  contact_type varchar(20) [default: 'supplier']
  company_name varchar(200) [not null, note: 'indexed']
  contact_person varchar(100)
  phone varchar(20) [note: 'indexed']
  whatsapp varchar(20)
  email varchar(100)
  gstin varchar(20)
  pan varchar(20)
  address text
  city varchar(100)
  state varchar(100)
  pincode varchar(10)
  source_type varchar(30)
  buyer_type varchar(30)
  credit_limit decimal(14,2) [default: 0]
  credit_days integer [note: 'Credit Days (Master Data crm_credit_days), 2026-11-10']
  outstanding decimal(14,2) [default: 0]
  tags varchar(300)
  notes text
  status varchar(20) [default: 'active']
  assigned_to varchar(50)
  created_by varchar(50)
  created_at datetime [default: `now()`]
  updated_at datetime [default: `now()`]
}

// ── crm_contact_numbers ──────────────────────────────────────
// Extra person+phone entries per contact (one contact → many numbers),
// added via the "Contact Numbers" section on the New/Edit Contact form.
// Primary phone/whatsapp stay on crm_contacts.
Table crm_contact_numbers {
  id uuid [pk, not null]
  contact_id uuid [not null, note: 'indexed, FK → crm_contacts.id, cascade delete']
  person_name varchar(100)
  phone varchar(20)
  email varchar(100)
  sort_order int [default: 0]
  created_at datetime [default: `now()`]
}
Ref: crm_contact_numbers.contact_id > crm_contacts.id

// ── crm_sourcing_deals ───────────────────────────────────────
Table crm_sourcing_deals {
  id uuid [pk, not null]
  from_entity varchar(100) [note: 'From Entity - issuing company entity; defaults to the creator entity (approved 2026-11-10)']
  deal_number varchar(30) [not null, unique, note: 'indexed']
  contact_id uuid [note: 'indexed']
  title varchar(300) [not null]
  source_type varchar(30)
  device_type varchar(50)
  est_quantity int
  material_type varchar(30)
  asking_price_unit decimal(10,2)
  asking_price_total decimal(14,2)
  our_offer_unit decimal(10,2)
  our_offer_total decimal(14,2)
  final_price_unit decimal(10,2)
  final_price_total decimal(14,2)
  stage varchar(30) [default: 'lead', note: 'indexed']
  inspection_date date
  inspection_result varchar(20)
  inspection_notes text
  expected_pickup_date date
  expected_close_date date [note: 'Expected Close Date, 2026-11-10']
  payment_advance_pct int [default: 0]
  payment_terms text
  linked_lot_id uuid
  win_loss_reason text
  assigned_to varchar(50)
  priority varchar(10) [default: 'medium']
  notes text
  product_records_file varchar(500) [note: 'stored filename under uploads/crm/']
  purchase_invoice_path varchar(500) [note: 'stored filename under uploads/crm/']
  purchase_order_path varchar(500) [note: 'stored filename under uploads/crm/']
  eway_bill_path varchar(500) [note: 'stored filename under uploads/crm/']
  quote_received_path varchar(500) [note: 'stored filename under uploads/crm/']
  created_by varchar(50)
  created_at datetime [default: `now()`]
  updated_at datetime [default: `now()`]
}

// ── crm_sales_opportunities ──────────────────────────────────
Table crm_sales_opportunities {
  id uuid [pk, not null]
  from_entity varchar(100) [note: 'From Entity - issuing company entity; defaults to the creator entity (approved 2026-11-10)']
  opp_number varchar(30) [not null, unique, note: 'indexed']
  contact_id uuid [note: 'indexed']
  title varchar(300) [not null]
  buyer_type varchar(30)
  device_type varchar(50)
  required_qty int
  material_type varchar(30)
  grade_required varchar(10)
  budget_per_unit decimal(10,2)
  stage varchar(30) [default: 'lead', note: 'indexed']
  quote_id uuid
  linked_sale_ids text
  expected_close_date date
  estimated_value decimal(14,2)
  win_loss_reason text
  assigned_to varchar(50)
  priority varchar(10) [default: 'medium']
  notes text
  created_by varchar(50)
  created_at datetime [default: `now()`]
  updated_at datetime [default: `now()`]
}

// ── crm_quotes ───────────────────────────────────────────────
Table crm_quotes {
  id uuid [pk, not null]
  from_entity varchar(100) [note: 'From Entity - issuing company entity; defaults to the creator entity (approved 2026-11-10)']
  quote_number varchar(30) [not null, unique, note: 'indexed']
  contact_id uuid [note: 'indexed']
  quote_date date [default: `now()`]
  valid_until date
  payment_terms varchar(200)
  special_conditions text
  total_amount decimal(14,2) [default: 0]
  status varchar(20) [default: 'draft']
  sent_at datetime
  created_by varchar(50)
  created_at datetime [default: `now()`]
  updated_at datetime [default: `now()`]
}

// ── crm_quote_items ──────────────────────────────────────────
Table crm_quote_items {
  id uuid [pk, not null]
  quote_id uuid [not null, note: 'indexed']
  line_number int [not null, default: 1]
  device_type varchar(100) [not null]
  material_type varchar(30)
  grade varchar(10)
  quantity int [not null, default: 1]
  unit_price decimal(10,2) [not null]
  total_price decimal(14,2) [not null]
  specs_note text
  sort_order int [default: 0]
}

// ── crm_activities ───────────────────────────────────────────
Table crm_activities {
  id uuid [pk, not null]
  contact_id uuid [note: 'indexed']
  deal_id uuid [note: 'indexed']
  deal_type varchar(20)
  activity_type varchar(20) [default: 'call']
  direction varchar(10)
  summary text [not null]
  outcome varchar(30)
  performed_by varchar(50) [not null]
  activity_date datetime [default: `now()`]
  next_followup datetime [note: 'indexed']
  followup_assigned_to varchar(50)
  followup_done bool [default: false, note: 'indexed']
  created_at datetime [default: `now()`]
}

// ── crm_grade_price_matrix ───────────────────────────────────
Table crm_grade_price_matrix {
  id uuid [pk, not null]
  device_type varchar(100) [not null, note: 'indexed']
  grade varchar(10) [not null]
  material_type varchar(30)
  brand varchar(50)
  min_buy_price decimal(10,2)
  max_buy_price decimal(10,2)
  target_sell decimal(10,2)
  min_margin_pct decimal(5,2) [default: 15.0]
  notes text
  updated_by varchar(50)
  updated_at datetime [default: `now()`]
  created_at datetime [default: `now()`]
}

// ── crm_purchase_orders ──────────────────────────────────────
Table crm_purchase_orders {
  id uuid [pk, not null]
  from_entity varchar(100) [note: 'From Entity - issuing company entity; defaults to the creator entity (approved 2026-11-10)']
  po_number varchar(30) [not null, unique, note: 'indexed']
  deal_id uuid
  contact_id uuid [note: 'indexed']
  po_date date [not null, default: `now()`]
  expected_delivery_date date
  delivery_address text
  payment_terms text
  advance_amount decimal(14,2)
  total_amount decimal(14,2) [default: 0]
  offer_total decimal(14,2) [note: 'our offer price, manually entered']
  status varchar(20) [default: 'draft']
  issued_by varchar(50)
  issued_at datetime
  notes text
  created_by varchar(50)
  created_at datetime [default: `now()`]
  updated_at datetime [default: `now()`]
}

// ── crm_po_line_items ────────────────────────────────────────
Table crm_po_line_items {
  id uuid [pk, not null]
  po_id uuid [not null]
  description varchar(300) [not null]
  device_type varchar(100)
  grade varchar(10)
  quantity int [not null, default: 1]
  unit_price decimal(10,2) [not null]
  total_price decimal(14,2) [not null]
  sort_order int [default: 0]
}

// ── crm_sourcing_deal_line_items ─────────────────────────────
// Draft PO line items accumulated on a sourcing deal; copied into
// crm_po_line_items when a PO is generated from the deal.
Table crm_sourcing_deal_line_items {
  id uuid [pk, not null]
  deal_id uuid [not null, note: 'indexed, FK → crm_sourcing_deals.id, cascade delete']
  item_name varchar(200) [not null]
  description text
  po_category varchar(100)
  lot_number varchar(50)
  device_type varchar(100)
  grade varchar(10)
  quantity int [not null, default: 1]
  unit_price decimal(10,2) [not null, default: 0]
  total_price decimal(14,2) [not null, default: 0]
  offer_price decimal(14,2) [note: 'our negotiated offer for this line, set via the Offer Price modal']
  sort_order int [default: 0]
}
Ref: crm_sourcing_deal_line_items.deal_id > crm_sourcing_deals.id

// ── terms_conditions ─────────────────────────────────────────
// Reusable long-form policies (payment/delivery/disclaimer) embedded
// into generated PO documents; managed in admin Terms & Conditions.
Table terms_conditions {
  id uuid [pk, not null]
  term_type varchar(20) [not null, note: 'indexed: payment/delivery/disclaimer']
  title varchar(200) [not null]
  content text [not null]
  is_active boolean [not null, default: true]
  display_order int [default: 0]
  created_by varchar(50)
  created_at datetime [default: `now()`]
  updated_at datetime [default: `now()`]
}

// ── supplier_payments ────────────────────────────────────────
Table supplier_payments {
  id uuid [pk, not null]
  contact_id uuid
  lot_id uuid
  po_id uuid
  payment_date date [not null, default: `now()`]
  amount decimal(14,2) [not null]
  payment_mode varchar(20)
  reference_no varchar(100)
  is_advance bool [default: false]
  notes text
  created_by varchar(50)
  created_at datetime [default: `now()`]
}

// ── customer_receipts ────────────────────────────────────────
Table customer_receipts {
  id uuid [pk, not null]
  contact_id uuid
  dealer_id uuid
  sale_id uuid
  dealer_order_id uuid
  receipt_date date [not null, default: `now()`]
  amount decimal(14,2) [not null]
  payment_mode varchar(20)
  reference_no varchar(100)
  notes text
  created_by varchar(50)
  created_at datetime [default: `now()`]
}

// ── qa_requirements ──────────────────────────────────────────
Table qa_requirements {
  id uuid [pk, not null]
  req_code varchar(30)
  title varchar(200) [not null]
  description text
  source varchar(30) [not null, default: 'PRD']
  priority varchar(20) [not null, default: 'Medium']
  status varchar(20) [not null, default: 'Open']
  module varchar(100)
  created_by varchar(100)
  created_at datetime [default: `now()`]
  updated_at datetime [default: `now()`]
}

// ── qa_test_cases ────────────────────────────────────────────
Table qa_test_cases {
  id uuid [pk, not null]
  tc_code varchar(30)
  requirement_id uuid
  title varchar(200) [not null]
  scenario text
  preconditions text
  steps text
  expected_result text
  type varchar(20) [not null, default: 'Functional']
  status varchar(10) [not null, default: 'Active']
  is_automated bool [default: false]
  module varchar(100)
  created_by varchar(100)
  created_at datetime [default: `now()`]
  updated_at datetime [default: `now()`]
}

// ── qa_test_executions ───────────────────────────────────────
Table qa_test_executions {
  id uuid [pk, not null]
  test_case_id uuid [not null]
  status varchar(10) [not null, default: 'Pass']
  actual_result text
  notes text
  build_version varchar(50)
  environment varchar(50) [default: 'QA']
  executed_by varchar(100)
  executed_at datetime [default: `now()`]
}

// ── qa_defects ───────────────────────────────────────────────
Table qa_defects {
  id uuid [pk, not null]
  defect_code varchar(30)
  test_case_id uuid
  title varchar(200) [not null]
  description text
  steps_to_reproduce text
  expected_result text
  actual_result text
  severity varchar(10) [not null, default: 'Medium']
  priority varchar(20) [not null, default: 'P3 - Medium']
  status varchar(15) [not null, default: 'New']
  module varchar(100)
  environment varchar(50) [default: 'QA']
  build_version varchar(50)
  assigned_to varchar(100)
  root_cause text
  resolution text
  reported_by varchar(100)
  reported_at datetime [default: `now()`]
  resolved_at datetime
  closed_at datetime
}

// ── qa_uat_scenarios ─────────────────────────────────────────
Table qa_uat_scenarios {
  id uuid [pk, not null]
  uat_code varchar(30)
  requirement_id uuid
  title varchar(200) [not null]
  scenario text
  acceptance_criteria text
  business_owner varchar(100)
  status varchar(20) [not null, default: 'Pending Execution']
  executed_by varchar(100)
  executed_at datetime
  result_notes text
  feedback text
  sign_off_by varchar(100)
  sign_off_at datetime
  created_by varchar(100)
  created_at datetime [default: `now()`]
}

// ── qa_releases ──────────────────────────────────────────────
Table qa_releases {
  id uuid [pk, not null]
  version varchar(50) [not null]
  title varchar(200)
  description text
  status varchar(15) [not null, default: 'Planned']
  planned_date datetime
  release_date datetime
  qa_sign_off_by varchar(100)
  qa_sign_off_at datetime
  uat_sign_off_by varchar(100)
  uat_sign_off_at datetime
  deployed_by varchar(100)
  notes text
  rollback_plan text
  created_by varchar(100)
  created_at datetime [default: `now()`]
  updated_at datetime [default: `now()`]
}


// ============================================================
// FOREIGN KEY REFERENCES
// ============================================================

// users pool
Ref: login_logs.user_id > users.id
Ref: user_permissions.user_id > users.id
Ref: audit_logs.user_id > users.id
Ref: attendance.user_id > users.id
Ref: device_location_logs.actor_id > users.id
Ref: inventory_audits.initiated_by > users.id
Ref: audit_scan_items.scanned_by > users.id
Ref: repair_jobs.engineer_id > users.id
Ref: qc_checks.inspector_id > users.id

// lots pool
Ref: devices.lot_id > lots.id
Ref: lot_line_items.lot_id > lots.id
Ref: spare_parts_consumption.lot_id > lots.id
Ref: crm_sourcing_deals.linked_lot_id > lots.id
Ref: supplier_payments.lot_id > lots.id

// lot_line_items
Ref: devices.lot_line_item_id > lot_line_items.id

// devices pool
Ref: stage_movements.device_id > devices.id
Ref: repair_jobs.device_id > devices.id
Ref: qc_checks.device_id > devices.id
Ref: sales.device_id > devices.id
Ref: returns.device_id > devices.id
Ref: spare_parts_consumption.device_id > devices.id
Ref: ram_tracking.device_id > devices.id
Ref: ram_tracking.destination_device_id > devices.id
Ref: repair_attempts.device_id > devices.id
Ref: device_costing.device_id > devices.id
Ref: spare_parts_ledger.device_id > devices.id
Ref: device_aging.device_id > devices.id
Ref: iqc_inspections.device_id > devices.id
Ref: stock_transfers.device_id > devices.id
Ref: device_location_logs.device_id > devices.id
Ref: audit_scan_items.device_id > devices.id

// repair pool
Ref: repair_attempts.repair_job_id > repair_jobs.id

// spare_parts pool
Ref: spare_parts_purchases.part_id > spare_parts.id
Ref: spare_parts_consumption.part_id > spare_parts.id
Ref: spare_parts_ledger.part_id > spare_parts.id

// dealers pool
Ref: dealer_assignments.dealer_id > dealers.id
Ref: dealer_calls.dealer_id > dealers.id
Ref: dealer_orders.dealer_id > dealers.id
Ref: dealer_credit_notes.dealer_id > dealers.id
Ref: dealer_credit_notes.order_id > dealer_orders.id
Ref: dealer_credit_notes.applied_to_order_id > dealer_orders.id
Ref: telecalling_records.dealer_id > dealers.id
Ref: whatsapp_messages.dealer_id > dealers.id
Ref: whatsapp_groups.linked_dealer_id > dealers.id
Ref: market_availability.dealer_id > dealers.id
Ref: customer_receipts.dealer_id > dealers.id

// location pool
Ref: device_location_logs.location_id > storage_locations.id
Ref: audit_scan_items.location_id > storage_locations.id
Ref: audit_scan_items.audit_id > inventory_audits.id

// stage pool
Ref: allowed_transitions.from_stage > stage_master.name
Ref: allowed_transitions.to_stage > stage_master.name

// sales pool
Ref: returns.sale_id > sales.id
Ref: customer_receipts.sale_id > sales.id

// CRM pool
Ref: crm_sourcing_deals.contact_id > crm_contacts.id
Ref: crm_sales_opportunities.contact_id > crm_contacts.id
Ref: crm_quotes.contact_id > crm_contacts.id
Ref: crm_activities.contact_id > crm_contacts.id
Ref: crm_purchase_orders.contact_id > crm_contacts.id
Ref: supplier_payments.contact_id > crm_contacts.id
Ref: customer_receipts.contact_id > crm_contacts.id
Ref: crm_quote_items.quote_id > crm_quotes.id
Ref: crm_sales_opportunities.quote_id > crm_quotes.id
Ref: crm_purchase_orders.deal_id > crm_sourcing_deals.id
Ref: crm_po_line_items.po_id > crm_purchase_orders.id
Ref: supplier_payments.po_id > crm_purchase_orders.id
Ref: customer_receipts.dealer_order_id > dealer_orders.id

// WhatsApp pool
Ref: market_availability.source_message_id > whatsapp_messages.id

// QA pool
Ref: qa_test_cases.requirement_id > qa_requirements.id
Ref: qa_uat_scenarios.requirement_id > qa_requirements.id
Ref: qa_test_executions.test_case_id > qa_test_cases.id
Ref: qa_defects.test_case_id > qa_test_cases.id

// ══════════════════════════════════════════════════════════════════════
// Sprint 29 — Workflow & Fulfilment pool (added Jun 2026)
// ══════════════════════════════════════════════════════════════════════

Table work_orders {
  id uuid [pk, not null]
  work_id varchar(12) [unique, not null, note: '12-digit WorkID']
  device_id uuid [not null, note: 'indexed']
  barcode varchar(100)
  stage varchar(5) [note: 'l1 | l2 | l3']
  assigned_role varchar(30)
  assigned_user_id uuid [note: 'indexed']
  assigned_username varchar(50)
  assigned_name varchar(100)
  status varchar(20) [not null, default: 'pending']
  source_transfer_id uuid
  assigned_at datetime [not null, default: `now()`]
  started_at datetime
  completed_at datetime
  created_by varchar(50)
  created_at datetime [default: `now()`]
  paused_since datetime [note: 'set when a required part hits 0 stock; cleared on resume']
  paused_days_total int [not null, default: 0, note: 'accumulated frozen days across pause cycles']
  requested_by_name varchar(100) [note: 'L1/L2 engineer full name who raised a Request-to-L3/L4 (Notes col on L3/L4 page)']
}

Table part_requests {
  id uuid [pk, not null]
  work_order_id uuid
  work_id varchar(12)
  device_id uuid [not null, note: 'indexed']
  barcode varchar(100)
  stage varchar(5)
  part_id uuid
  part_name varchar(150) [not null]
  requested_by varchar(50)
  engineer_name varchar(100)
  qty_requested int [not null, default: 1]
  qty_handed_over int [not null, default: 0]
  status varchar(20) [not null, default: 'requested', note: 'requested|handed_over|not_in_stock|procure']
  created_at datetime [default: `now()`]
  actioned_at datetime
  actioned_by varchar(50)
}

Table part_sourcing_requests {
  id uuid [pk, not null]
  part_request_id uuid
  part_id uuid
  part_code varchar(20)
  part_name varchar(150) [not null]
  qty_requested int [not null, default: 1]
  qty_sourced int [not null, default: 0]
  raised_by varchar(50)
  status varchar(10) [not null, default: 'open', note: 'open|closed']
  source_deal_id varchar(50)
  created_at datetime [default: `now()`]
  closed_at datetime
  closed_by varchar(50)
}

Table telecaller_dispatch_requests {
  id uuid [pk, not null]
  device_id uuid [not null, note: 'indexed']
  barcode varchar(100)
  telecaller_username varchar(50)
  telecaller_name varchar(100)
  qty_requested int [not null, default: 1]
  qty_available int [not null, default: 1]
  grade varchar(10)
  status varchar(20) [not null, default: 'requested', note: 'requested|approved|rejected']
  rejected_notes varchar(500) [note: 'shown as tooltip on Rejected pill (Inventory Requests + Ready to Sale)']
  rejected_at datetime
  rejected_by varchar(50)
  source varchar(20) [not null, default: 'device', note: 'device|lot — lot = Model Summary bulk request']
  model_name varchar(150)
  model_make varchar(100)
  created_at datetime [default: `now()`]
  approved_at datetime
  approved_by varchar(50)
}

// Sprint 29 refs
Ref: work_orders.device_id > devices.id
Ref: work_orders.assigned_user_id > users.id
Ref: work_orders.source_transfer_id > stock_transfers.id
Ref: part_requests.work_order_id > work_orders.id
Ref: part_requests.device_id > devices.id
Ref: part_requests.part_id > spare_parts.id
Ref: part_sourcing_requests.part_request_id > part_requests.id
Ref: part_sourcing_requests.part_id > spare_parts.id
Ref: telecaller_dispatch_requests.device_id > devices.id

// ═══════════════════════════════════════════════════════════════
// TRADE PARTNER POOL — dealer-facing B2B portal (partner_* tables)
// ═══════════════════════════════════════════════════════════════

// ── partner_listings ─────────────────────────────────────────
Table partner_listings {
  id uuid [pk, not null]
  listing_code varchar(20) [not null, unique, note: 'TPL-0001, indexed']
  listing_type varchar(20) [not null, note: 'finished_goods | bulk_lot | functional_ok | as_is']
  lot_id uuid [note: 'FK lots, nullable, indexed']
  title varchar(200) [not null]
  description text
  brand varchar(100)
  model_summary varchar(300)
  grade_summary varchar(100)
  qty_total int [not null, default: 0]
  qty_available int [not null, default: 0]
  moq int [not null, default: 1]
  dealer_price decimal(12,2) [not null, default: 0, note: 'per unit, dealer-safe']
  token_amount decimal(12,2) [not null, default: 0, note: 'resolved Rs per unit']
  hold_hours int [not null, default: 24]
  photos text [note: 'JSON list of filenames under uploads/partner/']
  status varchar(20) [not null, default: 'draft', note: 'draft | published | paused | sold_out']
  cost_basis decimal(12,2) [note: 'internal reference, NEVER dealer-exposed']
  floor_value decimal(12,2) [note: 'resolved floor at publish time']
  floor_override_by varchar(50) [note: 'set only on audited override']
  floor_override_reason text
  price_tier varchar(30) [not null, default: 'standard']
  visible_to_segment varchar(30) [not null, default: 'all']
  price_reviewed_at datetime [note: '48h stale-price rule']
  stock_intake_date datetime [note: 'ageing source: lot created_at / GRN date']
  created_by varchar(50)
  is_active bool [not null, default: true]
  created_at datetime [default: `now()`]
  updated_at datetime [default: `now()`]
  indexes {
    (status, listing_type)
  }
}

// ── partner_listing_devices ──────────────────────────────────
Table partner_listing_devices {
  id uuid [pk, not null]
  listing_id uuid [not null, note: 'indexed']
  device_id uuid [not null, note: 'indexed; blocks double-listing']
  created_at datetime [default: `now()`]
}

// ── partner_floor_config ─────────────────────────────────────
Table partner_floor_config {
  id uuid [pk, not null]
  listing_type varchar(20) [not null, note: 'indexed']
  floor_rule_type varchar(30) [not null, note: 'margin_pct | floor_price_pct | recovery_value | liquidation_min']
  floor_pct decimal(6,2)
  floor_value decimal(12,2)
  effective_from datetime [not null, default: `now()`, note: 'versioned, never overwritten']
  created_by varchar(50)
  created_at datetime [default: `now()`]
}

// ── partner_bookings ─────────────────────────────────────────
Table partner_bookings {
  id uuid [pk, not null]
  booking_number varchar(30) [not null, unique, note: 'TPB-0001, gap-safe']
  listing_id uuid [not null, note: 'indexed']
  dealer_id uuid [not null, note: 'indexed']
  qty int [not null]
  unit_price_snapshot decimal(12,2) [not null, note: 'immutable at booking']
  token_per_unit_snapshot decimal(12,2) [not null]
  token_total decimal(14,2) [not null]
  status varchar(30) [not null, default: 'pending_payment', note: 'pending_payment | proof_uploaded | confirmed_token | balance_pending | ready_for_dispatch | dispatched | rejected | expired | cancelled']
  expires_at datetime [not null]
  rejection_reason text
  confirmed_by varchar(50)
  balance_verified_by varchar(50)
  dispatched_at datetime
  created_at datetime [default: `now()`]
  updated_at datetime [default: `now()`]
  indexes {
    (status, expires_at)
  }
}

// ── partner_payment_proofs ───────────────────────────────────
Table partner_payment_proofs {
  id uuid [pk, not null]
  booking_id uuid [not null, note: 'indexed']
  proof_type varchar(10) [not null, default: 'token', note: 'token | balance']
  utr_reference varchar(100)
  amount_claimed decimal(14,2)
  screenshot_path varchar(500) [note: 'stored filename under uploads/partner/, served via authed route only']
  status varchar(20) [not null, default: 'pending', note: 'pending | verified | rejected']
  uploaded_at datetime [default: `now()`]
  verified_by varchar(50)
  verified_at datetime
}

// ── partner_settings ─────────────────────────────────────────
Table partner_settings {
  key varchar(50) [pk, note: 'default_hold_hours, default_token_pct, bank_details, upi_id, whatsapp_launch_template, incentive_text']
  value text
  updated_by varchar(50)
  updated_at datetime [default: `now()`]
}

// ── partner_login_logs ───────────────────────────────────────
Table partner_login_logs {
  id uuid [pk, not null]
  dealer_id uuid [note: 'indexed, nullable for unknown-phone attempts']
  phone_attempted varchar(30)
  ip_address varchar(50)
  user_agent varchar(300)
  success bool [not null, default: false]
  created_at datetime [default: `now()`, note: 'indexed']
}

// ── partner_listing_views ────────────────────────────────────
Table partner_listing_views {
  id uuid [pk, not null]
  listing_id uuid [not null, note: 'indexed']
  dealer_id uuid [not null, note: 'indexed']
  viewed_at datetime [default: `now()`, note: 'raw feed for dealer score']
}

Table lot_dealer_visibility {
  id uuid [pk, not null]
  lot_id uuid [not null, note: 'indexed']
  dealer_id uuid [not null, note: 'indexed']
  assigned_by varchar(50)
  assigned_at datetime [default: `now()`]
  indexes {
    (lot_id, dealer_id) [unique]
  }
}

Table lot_booking_requests {
  id uuid [pk, not null]
  lot_id uuid [not null, note: 'indexed']
  dealer_id uuid [not null, note: 'indexed']
  qty_requested int [not null, default: 1]
  status varchar(20) [not null, default: 'requested', note: 'requested | approved | withdrawn — indexed']
  created_at datetime [default: `now()`]
  updated_at datetime [default: `now()`]
}

// Trade Partner pool refs
Ref: partner_listings.lot_id > lots.id
Ref: partner_listing_devices.listing_id > partner_listings.id
Ref: partner_listing_devices.device_id > devices.id
Ref: partner_bookings.listing_id > partner_listings.id
Ref: partner_bookings.dealer_id > dealers.id
Ref: partner_payment_proofs.booking_id > partner_bookings.id
Ref: partner_login_logs.dealer_id > dealers.id
Ref: partner_listing_views.listing_id > partner_listings.id
Ref: partner_listing_views.dealer_id > dealers.id
Ref: lot_dealer_visibility.lot_id > lots.id
Ref: lot_dealer_visibility.dealer_id > dealers.id
Ref: lot_booking_requests.lot_id > lots.id
Ref: lot_booking_requests.dealer_id > dealers.id

// ═══════════════════════════════════════════════════════════════
// CUSTOMER CARE AGENT POOL — post-sale warranty/diagnostics/ticketing
// (care_* tables)
// ═══════════════════════════════════════════════════════════════

// ── care_device_pairings ──────────────────────────────────────
Table care_device_pairings {
  id uuid [pk, not null]
  device_id uuid [not null, note: 'indexed']
  sale_id uuid [note: 'nullable, indexed']
  serial_no varchar(100)
  provisioning_token_hash varchar(64) [unique, note: 'sha256, single-use, nulled on redemption']
  provisioning_token_expires_at datetime
  provisioning_redeemed_at datetime
  device_token_hash varchar(64) [unique, note: 'sha256 of long-lived device credential']
  device_token_issued_at datetime
  token_last_rotated_at datetime
  paired_at datetime
  agent_version varchar(20)
  last_seen_at datetime
  last_ip_hash varchar(64) [note: 'hashed, never raw IP at rest']
  is_active bool [not null, default: false]
  revoked_at datetime
  revoked_reason varchar(200)
  marketing_opt_in bool [not null, default: false, note: 'customer consent for care_offers.is_marketing sends — Phase 5, defaults false everywhere until a tray privacy screen exists']
  created_by varchar(50) [note: 'staff username who created the pending pairing']
  created_at datetime [default: `now()`]
  updated_at datetime [default: `now()`]
  indexes {
    (device_id, is_active)
  }
}

// ── care_warranties ────────────────────────────────────────────
Table care_warranties {
  id uuid [pk, not null]
  device_id uuid [not null, note: 'indexed']
  sale_id uuid [note: 'nullable, indexed']
  policy_id varchar(50)
  coverage_type varchar(30) [note: 'main_device | battery | adapter | accessory']
  start_event varchar(30) [note: 'invoice_date | delivery_date | replacement_dispatch']
  start_date datetime
  expiry_date datetime
  battery_expiry_date datetime
  status varchar(20) [not null, default: 'not_started', note: 'not_started|active|expiring|expired|void|suspended|replaced|returned|bought_back']
  extension_reference varchar(100)
  replacement_reference varchar(100)
  void_reason text
  created_at datetime [default: `now()`]
  updated_at datetime [default: `now()`]
}

// ── care_support_tickets ───────────────────────────────────────
Table care_support_tickets {
  id uuid [pk, not null]
  ticket_number varchar(20) [not null, unique, note: 'CARE-0001, indexed']
  pairing_id uuid [not null, note: 'indexed']
  device_id uuid [not null, note: 'indexed']
  sale_id uuid
  category varchar(50) [not null]
  subcategory varchar(50)
  description text [not null]
  priority varchar(10) [not null, default: 'medium']
  status varchar(20) [not null, default: 'open', note: 'open|assigned|in_progress|awaiting_customer|needs_pickup|resolved|closed|cancelled|reopened']
  customer_contact_preference varchar(20) [note: 'call | whatsapp | email']
  assigned_to varchar(50)
  resolved_by varchar(50)
  resolution_notes text [note: 'internal only']
  customer_visible_notes text
  pickup_required bool [not null, default: false]
  pickup_reference varchar(50)
  remote_session_requested bool [not null, default: false, note: 'Phase 2 hook']
  remote_session_consented_at datetime [note: 'Phase 2 hook']
  idempotency_key varchar(100) [unique, note: 'dedupes offline-queue retries']
  created_at datetime [default: `now()`]
  updated_at datetime [default: `now()`]
  resolved_at datetime
  closed_at datetime
  indexes {
    (pairing_id, status)
  }
}

// ── care_ticket_events ─────────────────────────────────────────
Table care_ticket_events {
  id uuid [pk, not null]
  ticket_id uuid [not null, note: 'indexed']
  event_type varchar(30) [not null, note: 'created | status_change | assigned | note_added | resolved']
  old_status varchar(20)
  new_status varchar(20)
  actor_type varchar(10) [not null, default: 'staff', note: 'staff | customer | system']
  actor_id varchar(50)
  notes text
  created_at datetime [default: `now()`]
}

// ── care_diagnostic_snapshots ──────────────────────────────────
Table care_diagnostic_snapshots {
  id uuid [pk, not null]
  pairing_id uuid [not null, note: 'indexed']
  ticket_id uuid [note: 'nullable, indexed']
  diagnostic_profile varchar(30) [not null, default: 'support_basic_v1']
  schema_version int [not null, default: 1]
  agent_version varchar(20)
  bios_serial varchar(100)
  manufacturer varchar(100)
  model varchar(100)
  cpu varchar(150)
  ram_gb int
  storage_summary varchar(200)
  battery_health_pct int
  battery_cycle_count int
  smart_status varchar(20)
  os_version varchar(100)
  hardware_warning_summary text
  system_error_summary text [note: 'redacted — no filenames/usernames']
  raw_json json [note: 'full allowlisted payload']
  captured_at datetime [default: `now()`]
  created_at datetime [default: `now()`]
}

// ── care_offers ─────────────────────────────────────────────────
Table care_offers {
  id uuid [pk, not null]
  title varchar(200) [not null]
  body text
  image_url varchar(500)
  cta_label varchar(50)
  cta_url varchar(500)
  starts_at datetime
  ends_at datetime
  target_type varchar(30) [not null, default: 'all', note: 'all | model | warranty_window | sale_range']
  target_value varchar(200)
  channel varchar(20) [not null, default: 'in_app', note: 'in_app | whatsapp | both']
  is_marketing bool [not null, default: true]
  consent_required bool [not null, default: true]
  created_by varchar(50)
  is_active bool [not null, default: true]
  created_at datetime [default: `now()`]
  updated_at datetime [default: `now()`]
}

// ── care_agent_events ───────────────────────────────────────────
Table care_agent_events {
  id uuid [pk, not null]
  pairing_id uuid [not null, note: 'indexed']
  event_type varchar(40) [not null, note: 'agent_started | pairing_completed | ticket_submitted | ...']
  agent_version varchar(20)
  metadata_json json
  occurred_at datetime [default: `now()`, note: 'indexed']
}

// ── care_audit_logs ─────────────────────────────────────────────
Table care_audit_logs {
  id uuid [pk, not null]
  action varchar(50) [not null]
  pairing_id uuid [note: 'indexed']
  ticket_id uuid [note: 'indexed']
  actor_type varchar(10) [not null, default: 'staff', note: 'staff | customer | system']
  actor_id varchar(50)
  old_value json
  new_value json
  ip_hash varchar(64)
  created_at datetime [default: `now()`, note: 'indexed']
}

// Customer Care Agent pool refs
Ref: care_device_pairings.device_id > devices.id
Ref: care_device_pairings.sale_id > sales.id
Ref: care_warranties.device_id > devices.id
Ref: care_warranties.sale_id > sales.id
Ref: care_support_tickets.pairing_id > care_device_pairings.id
Ref: care_support_tickets.device_id > devices.id
Ref: care_support_tickets.sale_id > sales.id
Ref: care_ticket_events.ticket_id > care_support_tickets.id
Ref: care_diagnostic_snapshots.pairing_id > care_device_pairings.id
Ref: care_diagnostic_snapshots.ticket_id > care_support_tickets.id

// ── care_dispatch_exceptions (Phase 4) ──────────────────────────
Table care_dispatch_exceptions {
  id uuid [pk, not null]
  device_id uuid [not null, note: 'indexed']
  reason varchar(30) [not null, note: 'corporate_no_software | non_windows | clean_os_request | as_is_sale | temporary_technical']
  notes text
  approved_by varchar(50)
  expires_at datetime
  is_active bool [not null, default: true]
  created_at datetime [default: `now()`]

  Note: 'Advisory only — routers/dispatch.py and routers/sales.py do not hard-block on this yet. See models.care.CareDispatchException docstring.'
}

// ── care_offer_deliveries (Phase 5) ─────────────────────────────
Table care_offer_deliveries {
  id uuid [pk, not null]
  offer_id uuid [not null, note: 'indexed']
  device_id uuid [not null, note: 'indexed']
  channel varchar(20) [not null, note: 'in_app | whatsapp']
  delivery_status varchar(20) [not null, default: 'sent', note: 'sent | failed | skipped_no_consent']
  error_message varchar(300)
  sent_at datetime [default: `now()`]
  sent_by varchar(50)
}

Ref: care_dispatch_exceptions.device_id > devices.id
Ref: care_offer_deliveries.offer_id > care_offers.id
Ref: care_offer_deliveries.device_id > devices.id
